<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 10–11 backup rules (Android 12+ uses data_extraction_rules.xml). Backup is off
  (allowBackup=false); this keeps everything excluded even if it is turned on: the TDLib database
  and its wrapped key must never be restored onto another device, where they cannot be decrypted.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
